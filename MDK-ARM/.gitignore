# =====================================================================
# MDK-ARM：只保留 Keil 工程文件 + 编译输出目录的"壳" + 最终 hex
# 注意：下面的模式行不能写行尾注释，注释一律单独成行。
# =====================================================================

# ---------- 编译器 / IDE 自动生成，与源代码无关：一律屏蔽 ----------
# eide 导入的 ARM 全系列 CMSIS 模板（约 4 MB）
/.cmsis/
# Keil 器件支持包 STM32F1xx_DFP（约 87 MB）
/.pack/
# VSCode EIDE 扩展配置（本工程以 Keil 的 uvprojx 为准）
/.eide/
# VSCode 工作区配置
/.vscode/
/.settings/
/power_control.code-workspace
# RTE 目录整个屏蔽：uVision 会自动生成 RTE\_<target>\RTE_Components.h
# 与 RTE\Device\ 下的器件文件，工程打开时自动重建
/RTE/
# EIDE 扩展自动生成的同名头文件（文件头写着 don't modify）
/RTE_Components.h
# Keil 窗口布局，跟人不跟工程
*.uvguix.*
# 汇编列表文件，编译产物
*.lst

# ---------- 编译输出目录：保留文件夹壳，内容不上传 ----------
# EIDE 输出目录
/build/*
!/build/.gitkeep

# Keil MDK 输出目录（uvprojx 中的 OutputDirectory=power_control\）
# 只放行文件夹壳与最终 hex；.o/.crf/.d/.map/.htm/.lnp 等一律不上传
/power_control/*
!/power_control/.gitkeep
!/power_control/*.hex

/bin
/obj
/out

# eide template
*.ept
*.eide-template
